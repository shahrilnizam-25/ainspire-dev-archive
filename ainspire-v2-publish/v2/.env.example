# Optional integrations. GiGX is the primary LLM; API Gateway is the fallback.
GIGX_API_KEY=
# GIGX_API_URL=https://gigx.nexa-dev.tm.com.my/llm/v1/chat/completions
# GIGX_LLM_MODEL=qwen3-vl-4b-instruct
TM_APIGATE_CLIENT_ID=
TM_APIGATE_CLIENT_SECRET=
TM_APIGATE_CHAT_KEY=
# Optional overrides; omit to use the code defaults.
# TM_APIGATE_TOKEN_URL=https://api.apigate.tm.com.my/token
# TM_APIGATE_API_URL=https://api.apigate.tm.com.my/t/tm.com.my/AI-Foundry-Service/1.82.1/v1/chat/completions
TM_LLM_MODEL=gpt-oss-20b
# YouTube learning search; optional, curated resources work without keys.
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_BACKUP=
# Power Automate HTTP-trigger URL is a secret; keep it in the local .env / Sites runtime secrets.
POWER_AUTOMATE_TRIGGER_URL=
AINSPIRE_PORTAL_URL=https://ainspire.sooct2003.chatgpt.site
AINSPIRE_NOTIFICATION_EMPLOYEE=shahril.abdullah@tm.com.my
AINSPIRE_NOTIFICATION_SUPERVISOR=ctsoo@tm.com.my
AINSPIRE_NOTIFICATION_HR=noorain.ismail@tm.com.my
# Local Postgres for the Staff ID org simulation only (pnpm demo-seed, pnpm demo-api). Assessment records stay in browser localStorage.
DATABASE_URL=

# Local dev only. Start `pnpm llm-proxy`; it skips TLS verification for the provider hosts above. Ignored in production.
# LLM_DEV_PROXY_URL=http://127.0.0.1:8788
